# Base path the app calls. Left as a relative path so the Vite dev proxy below
# forwards it to the backend and everything stays same-origin in development.
VITE_API_BASE_URL=/api/v1

# Where the dev proxy forwards /api requests. Must match the backend PORT.
VITE_API_PROXY_TARGET=http://localhost:5000

VITE_APP_NAME=DocuMind AI
